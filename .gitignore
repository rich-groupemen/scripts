# OS
.DS_Store
Thumbs.db

# Local overrides (never commit machine-specific tool versions/settings)
.mise.local.toml
mise.local.toml

# Logs & scratch
*.log
*.tmp

# PowerShell
*.bak

# AD Tools — temporary cleartext credential record. Written outside the repo by
