# Repo-wide ShellCheck policy — see README.md "Conventions".
# Per-script overrides go in the script as directives, e.g.:
#   # shellcheck disable=SC2312

# Show everything, including style suggestions.
severity=style

# Source paths relative to the checked file, so `source ../lib/x.sh` resolves.
source-path=SCRIPTDIR

# Sourced files (lib/) may reference caller-provided variables.
external-sources=true

# Opt into the stricter optional checks this repo has adopted.
enable=require-variable-braces,quote-safe-variables,avoid-nullary-conditions,check-unassigned-uppercase,deprecate-which
