# Editor + formatter agreement in one file.
# shfmt reads the shfmt-* properties below directly, so editors, local
# linting, and CI all converge on the same output.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# --- bash (shfmt reads these unprefixed names directly) ---
[*.sh]
switch_case_indent = true
space_redirects = true
binary_next_line = false

[*.bash]
switch_case_indent = true
space_redirects = true
binary_next_line = false

# --- PowerShell: 4-space, community convention ---
[*.{ps1,psm1,psd1}]
indent_size = 4

# Makefiles require literal tabs
[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
